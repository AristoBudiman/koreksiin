# ==============================================================================
# KONFIGURASI LINGKUNGAN KOREKSI.IN
# Salin file ini menjadi .env dan sesuaikan nilainya sebelum menjalankan Docker.
# ==============================================================================

# --- Port & Aplikasi ---
APP_PORT=8080
BACKEND_PORT=8000

# --- PostgreSQL 16 ---
POSTGRES_USER=koreksiin
POSTGRES_PASSWORD=koreksiin_secret_db_pass
POSTGRES_DB=koreksiin_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://koreksiin:koreksiin_secret_db_pass@postgres:5432/koreksiin_db?sslmode=disable

# --- Redis 7 ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
SCORING_QUEUE=queue:scoring
TRAINING_QUEUE=queue:training

# --- Autentikasi & Keamanan ---
# Ganti dengan string acak minimal 32 karakter
JWT_SECRET=koreksiin_super_secret_jwt_key_2026_change_me
JWT_EXPIRES_HOURS=72

# --- Akun Admin Default (Dibuat otomatis saat startup jika belum ada) ---
ADMIN_NAME=Administrator Koreksi.in
ADMIN_EMAIL=admin@koreksi.in
ADMIN_PASSWORD=AdminKoreksiin2026!

# --- Pipeline AI & Worker ---
BASE_MODEL_NAME=LazarusNLP/all-indobert-base-v4
HF_HOME=/hf_cache
STORAGE_DIR=/storage
MIN_TRAIN_SAMPLES=20
TRAINER_THREADS=2
DEFAULT_T_HIGH=0.60
DEFAULT_T_LOW=0.45
DEFAULT_S_SEM=0.92
DEFAULT_S_LEX=0.60

# --- Midtrans Snap (Sandbox) ---
# Isi dengan Server Key dan Client Key dari Dashboard Midtrans Sandbox Anda
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY_HERE
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY_HERE
MIDTRANS_IS_PRODUCTION=false

# Opsional: URL publik tetap (mis. domain sendiri). Jika dikosongkan, backend otomatis
# mengambil URL dari container tunnel (http://tunnel:2000/quicktunnel) dan mengirimkannya
# ke Midtrans lewat header X-Override-Notification pada setiap pembuatan transaksi Snap.
PUBLIC_BASE_URL=


